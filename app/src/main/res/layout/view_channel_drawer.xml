<?xml version="1.0" encoding="utf-8"?>
<!--
    Channel drawer overlay. Inflated by ChannelDrawer.kt into
    R.id.drawer_host, which sits on top of the video surface.
    Width is 30% of the screen; the right 70% keeps playing the
    video uninterrupted.

    We use a semi-transparent background (CC = 80% opacity) so the
    video underneath is visible — gives the user a feeling of
    "picking a new channel while still seeing the old one".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E6111822"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Channels"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

    <ListView
        android:id="@+id/drawer_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#33FFFFFF"
        android:dividerHeight="1dp"
        android:listSelector="@android:color/transparent"
        android:cacheColorHint="#00000000"
        android:scrollbars="vertical" />

</LinearLayout>
