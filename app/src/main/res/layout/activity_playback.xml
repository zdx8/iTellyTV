<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!--
        Video surface. Created once, lives for the entire activity
        lifetime — we do not swap it (mirrors the iTelly-macOS
        "VLCCAOpenGLLayer cannot be re-parented mid-flight" rule).
        focusable=false so it never steals D-pad focus from the
        channel drawer (otherwise a focusable SurfaceView behind
        the drawer can intercept DPAD_CENTER / ENTER on some
        Android TV builds and our onKeyDown never sees it).
    -->
    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Error overlay (visible only on error). -->
    <TextView
        android:id="@+id/error_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="32dp"
        android:background="#CC000000"
        android:textColor="#FF6B6B"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- Top-left debug strip: URL + title. -->
    <TextView
        android:id="@+id/debug_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:padding="12dp"
        android:background="#80000000"
        android:textColor="#CCCCCC"
        android:textSize="12sp" />

    <!-- Top-right state strip: shows current PlaybackState. -->
    <TextView
        android:id="@+id/state_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:padding="12dp"
        android:background="#80000000"
        android:textColor="#9CCC65"
        android:textSize="12sp" />

    <!-- Bottom-left position strip: shows current position / duration. -->
    <TextView
        android:id="@+id/position_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:padding="12dp"
        android:background="#80000000"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!--
        Channel drawer host. Inflated by ChannelDrawer.kt with
        R.layout.view_channel_drawer. Starts `invisible` (not
        `gone`) so the ListView inside measures and lays out its
        children on the very first frame — important so the
        "currently playing" row's blue highlight is painted
        from the start. The user can't see it because `invisible`
        hides the contents. When the user presses LEFT, the host
        flips to `visible` and the highlight is already there.
    -->
    <FrameLayout
        android:id="@+id/drawer_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

</FrameLayout>
