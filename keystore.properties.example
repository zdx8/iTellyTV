# iTellyTV Release Keystore Configuration
#
# This file is used only for LOCAL builds. On CI, secrets are read
# directly from GitHub Actions repository secrets — this file is
# .gitignored and never committed.
#
# Generate the keystore (run once, store the .keystore file outside
# the repo, e.g. in your password manager):
#
#   keytool -genkeypair -v \
#     -keystore itellytv-release.keystore \
#     -alias itellytv-release \
#     -keyalg RSA -keysize 2048 -validity 10950 \
#     -storepass 'YOUR_STORE_PASSWORD' \
#     -keypass   'YOUR_KEY_PASSWORD' \
#     -dname "CN=iTellyTV, OU=zdx8, O=zdx8, L=Beijing, ST=Beijing, C=CN"
#
# Place the .keystore at app/signing/itellytv-release.keystore and
# fill in this file's values. Then `./gradlew :app:assembleRelease`
# produces an APK you can install directly.
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=itellytv-release
storeFile=../signing/itellytv-release.keystore
